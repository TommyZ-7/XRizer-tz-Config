#!/bin/sh
HERE="$(dirname "$(readlink -f "$0")")"
export APPDIR="$HERE"
export PATH="$HERE/usr/bin:$PATH"
export LD_LIBRARY_PATH="$HERE/usr/lib:$HERE/usr/lib/x86_64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
FONT_FILE="${TZ_CONTROLLER_FONT:-${XRIZER_TZ_CONFIG_FONT:-}}"
if [ -z "$FONT_FILE" ]; then
    FONT_FILE="$(find "$HERE/usr/share/fonts" -type f 2>/dev/null | head -n 1 || true)"
fi
if [ -n "$FONT_FILE" ]; then
    export TZ_CONTROLLER_FONT="$FONT_FILE"
fi
exec "$HERE/usr/bin/tz-controller" "$@"
